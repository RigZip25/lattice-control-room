{
  "name": "lattice-control-room",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "test": "pnpm --filter @lattice/core test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter @lattice/core build && pnpm --filter @lattice/demo build && pnpm --filter @lattice/control-room build",
    "demo": "pnpm build && node apps/demo/dist/main.js",
    "control-room": "pnpm build && pnpm --filter @lattice/control-room start"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
