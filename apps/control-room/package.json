{
  "name": "@lattice/control-room",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --outDir dist",
    "typecheck": "pnpm --filter @lattice/core build && tsc --noEmit",
    "verify": "pnpm --filter @lattice/core build && node scripts/verify-ui.mjs",
    "verify:runtime": "pnpm build && node scripts/verify-runtime.mjs",
    "start": "node dist/server.js"
  },
  "dependencies": { "@lattice/core": "workspace:*" },
  "devDependencies": { "@types/node": "^24.3.0", "typescript": "^5.9.2" }
}
